# Git attributes to enforce LF line endings
# Place this as .gitattributes in repository root

# Default behavior: auto-detect text files and normalize to LF
* text=auto

# Source code - always LF
*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.hpp   text eol=lf
*.cc    text eol=lf

# Python - always LF
*.py    text eol=lf

# Shell scripts - always LF
*.sh    text eol=lf
*.bash  text eol=lf

# Build files - always LF
Makefile        text eol=lf
*.mk            text eol=lf
*.am            text eol=lf
*.ac            text eol=lf
configure       text eol=lf
*.m4            text eol=lf

# Configuration files - always LF
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.xml           text eol=lf
*.conf          text eol=lf
*.config        text eol=lf
*.ini           text eol=lf

# Documentation - always LF
*.md            text eol=lf
*.txt           text eol=lf
*.rst           text eol=lf

# Patches and diffs - always LF
*.patch         text eol=lf
*.diff          text eol=lf

# Binary files - don't modify
*.bin           binary
*.o             binary
*.so            binary
*.a             binary
*.ko            binary
*.swi           binary
*.deb           binary
*.rpm           binary
*.img           binary
*.iso           binary
*.tar           binary
*.gz            binary
*.bz2           binary
*.xz            binary
*.zip           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.pdf           binary
